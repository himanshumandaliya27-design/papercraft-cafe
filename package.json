{
  "name": "atelier-velin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/customer-site",
    "apps/admin-site"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:customer": "npm run build --workspace=apps/customer-site",
    "build:admin": "npm run build --workspace=apps/admin-site",
    "build:all": "npm run build:customer && npm run build:admin",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');['dist','apps/customer-site/dist','apps/admin-site/dist'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch{}})\"",
    "lint": "tsc --noEmit",
    "seed": "tsx scripts/seedFirestore.ts",
    "seed:demo": "tsx scripts/seedDemo.ts",
    "create-owner": "tsx scripts/createOwner.ts",
    "test:rules": "tsx scripts/testFirestoreRules.ts",
    "test:qr": "node scripts/runCheck.cjs testQRCode.ts",
    "test:a11y": "tsx scripts/testAccessibility.tsx",
    "test:e2e": "tsx scripts/runE2EProof.ts",
    "check:no-fake-data": "node scripts/runCheck.cjs checkNoFakeData.ts",
    "check:case-sensitivity": "node scripts/runCheck.cjs checkCaseSensitivity.ts"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@grpc/grpc-js": "^1.14.6",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  }
}
