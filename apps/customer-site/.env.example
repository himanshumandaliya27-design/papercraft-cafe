# ============================================================
# Atelier Vélin — Customer Site Environment Variables
# Copy this file to .env and fill in your values.
# Vite variables are baked in at BUILD TIME — redeploy after changes.
# ============================================================

# --- Firebase Configuration (REQUIRED for production) ---
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# --- App Mode (REQUIRED) ---
# "production" = real data only, no demo fallback
# "demo" = demo data with visible DEMO ribbon
VITE_APP_MODE="production"

# --- Production Firebase Project ID (safety guard for seed scripts) ---
VITE_PRODUCTION_PROJECT_ID="your-project-id"

# --- Customer Site Public URL (REQUIRED for QR codes) ---
# Set this to the live URL where customers access the site
# Example: https://cafe.yourdomain.com or https://your-site.netlify.app
VITE_CUSTOMER_SITE_URL="https://your-customer-site.netlify.app"

# --- Admin Portal URL (optional, shown in footer links) ---
VITE_ADMIN_PORTAL_URL="https://your-admin-site.netlify.app"
