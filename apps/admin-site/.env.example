# ============================================================
# Atelier Vélin — Admin Site Environment Variables
# Copy this file to .env and fill in your values.
# Vite variables are baked in at BUILD TIME — redeploy after changes.
# ============================================================

# --- Firebase Configuration (REQUIRED for production) ---
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# --- App Mode (REQUIRED) ---
VITE_APP_MODE="production"

# --- Production Firebase Project ID ---
VITE_PRODUCTION_PROJECT_ID="your-project-id"

# --- Customer Site Public URL (REQUIRED for QR codes) ---
VITE_CUSTOMER_SITE_URL="https://your-customer-site.netlify.app"

# --- Admin Portal URL ---
VITE_ADMIN_PORTAL_URL="https://your-admin-site.netlify.app"

# --- Firebase Cloud Messaging (OPTIONAL — requires Blaze plan) ---
# VAPID key for Web Push notifications
# Get from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=""

# --- Feature Flags ---
# Enable FCM push notifications (requires Blaze plan + Cloud Functions)
VITE_ENABLE_FCM_PUSH="false"
